# Copia este archivo a .env (no se sube a git). En desarrollo todo tiene un valor por defecto.
NODE_ENV=development
PORT=3000

# Base de datos. Desarrollo: `npm run dev:db` levanta una en el puerto 27017.
MONGODB_URI=mongodb://127.0.0.1:27017/libro-interactivo

# Orígenes permitidos por CORS (separados por coma). En producción: el dominio del sitio.
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# Sesiones. En producción JWT_ACCESS_SECRET es OBLIGATORIA (aleatoria, ≥ 32 caracteres; genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))" ). Nunca la subas a git.
# JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_DOMAIN=            # solo si web y API están en subdominios de un mismo dominio propio

# URL pública del sitio web: se usa para armar los enlaces de los correos (restablecer contraseña).
APP_URL=http://localhost:5173
RESET_TOKEN_TTL_MINUTES=30

# Correo. MAIL_PROVIDER: memory (desarrollo: solo muestra el correo en la consola) | gmail | resend.
# En producción NO puede ser memory.
MAIL_PROVIDER=memory
# Remitente. Con Resend es obligatorio y debe usar un dominio verificado en Resend. Con Gmail es la propia cuenta.
# MAIL_FROM="Libro Interactivo <avisos@midominio.com>"
# --- Gmail por SMTP (cuenta EXCLUSIVA de la app, con verificación en dos pasos y contraseña de aplicación).
# --- OJO: Render gratis bloquea SMTP; solo funciona en un servicio de pago o en local.
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# --- Resend (API HTTP; funciona en Render gratis; exige verificar un dominio)
# RESEND_API_KEY=
# Correo de la autora donde llegan los mensajes de contacto (luego se podrá cambiar desde el panel)
# CONTACT_RECIPIENT_EMAIL=
# Probar el envío real: npm run mail:test -w apps/api -- destinatario@ejemplo.com

# Primer administrador (solo para `npm run seed:admin`; se pone en tu .env local o en Render, nunca en git)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_ADMIN_PASSWORD=

# Cloudinary: subida firmada de imágenes y videos desde el panel (las tres juntas o ninguna). El secreto nunca va a git.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Códigos QR: token = id + HMAC con este secreto (≥ 32 caracteres, DISTINTO de JWT_ACCESS_SECRET). En producción es
# obligatorio. RESPÁLDALO fuera del repo: si se pierde o se cambia, todos los QR impresos dejan de funcionar.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ACCESS_TOKEN_SECRET=
# Exigir el QR canjeado para abrir un quiz: por defecto true en producción y false en desarrollo/pruebas.
# REQUIRE_QR_UNLOCK=false

# Almacenamiento PRIVADO S3-compatible (Cloudflare R2, S3…) para los capítulos extra. Las cuatro juntas o ninguna.
# Sin ellas se usa uno en memoria (los extras de texto funcionan; los archivos no). El bucket necesita CORS (PUT/GET).
# S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto            # R2: auto
# S3_FORCE_PATH_STYLE=true  # R2: true; S3 de AWS: false
# Cargar quizzes de ejemplo (necesita un ADMIN): npm run seed:quizzes -w apps/api

# --- Se agregarán en fases siguientes (no poner valores reales en este archivo) ---
